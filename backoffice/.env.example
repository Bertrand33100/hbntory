# Copier ce fichier en .env puis remplacer les valeurs.
# Ne jamais committer le fichier .env.

# Adresse de la base PostgreSQL
DATABASE_URL=postgresql://utilisateur:mot_de_passe@localhost:5432/hbntory

# Mot de passe de l'administrateur créé par seed.py
ADMIN_PASSWORD=a_remplacer

# Mot de passe de l'utilisateur d'exemple créé par seed.py
USER_PASSWORD=a_remplacer

# Clé de signature des cookies de session (longue et aléatoire)
SECRET_KEY=a_remplacer

# Mettre 1 en production (HTTPS) pour n'envoyer le cookie qu'en connexion sécurisée
COOKIE_SECURE=0
